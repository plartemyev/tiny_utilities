# Static pacman repository server. busybox httpd: tiny, supports byte-range
# requests (pacman resume), no directory listing. The repo tree is mounted
# read-only; artifacts are written by the nightly builder container.
FROM archlinux:latest
RUN pacman-key --init \
    && pacman -Sy --noconfirm archlinux-keyring \
    && pacman -Syu --noconfirm busybox \
    && rm -rf /var/cache/pacman/pkg/* /var/lib/pacman/sync/*
USER 65534:65534
EXPOSE 8080
HEALTHCHECK --interval=60s --timeout=5s \
    CMD busybox wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
CMD ["busybox", "httpd", "-f", "-p", "8080", "-h", "/srv"]
